# ============================================================
# RiskLens Backend — Environment Variables (EXAMPLE / SAFE)
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

# --- MongoDB Atlas ---
MONGODB_USERNAME="your_atlas_username"
MONGODB_PASSWORD="your_atlas_password"
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net"
MONGODB_DB_NAME="risklens"

# --- FastAPI ---
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
SECRET_KEY="change-this-to-a-long-random-secret-key"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# --- Quant defaults ---
RISK_FREE_RATE=0.065
